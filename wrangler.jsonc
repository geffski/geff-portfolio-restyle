{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geffweb",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "dist/client"
  },
  "observability": {
    "enabled": true
  }
}
